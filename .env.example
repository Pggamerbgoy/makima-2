# ==============================================================================
# MAKIMA ENVIRONMENT CONFIGURATION TEMPLATE (.env)
# ==============================================================================
# Copy this file to '.env' and populate your API keys:
#   cp .env.example .env
#
# NOTE: You DO NOT need to configure every provider. Makima's dynamic Pareto
# Router automatically detects which keys are provided and routes all agent tasks
# to your active and available provider(s).
#
# Makima also features a Smart Key Sniffer:
# Even if you name variables with custom prefixes (e.g., MY_GEMINI_KEY or GROQ_KEY)
# or format signatures (AIzaSy..., gsk_..., sk-or-v1-..., sk-ant-...), Makima
# will auto-bind them to the matching provider.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRIMARY LLM PROVIDERS (Choose at least ONE, or run local Ollama)
# ------------------------------------------------------------------------------

# Google Gemini (Default Fast & Multimodal Model)
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# Groq (Ultra-Fast Free/Cheap Inference — Llama 3.3 70B, Qwen, etc.)
# Get key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# OpenRouter (Unified Gateway for DeepSeek, Claude, Llama, Mistral)
# Get key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Anthropic Claude (Claude 3.5 Sonnet, Haiku, Opus)
# Get key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (GPT-4o, GPT-4o-mini, o1, o3-mini)
# Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Alibaba Cloud DashScope / Qwen Models (Qwen 2.5, Qwen 3.8)
# Get key from: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-...

# DeepSeek Official API (DeepSeek-V3, DeepSeek-R1)
# Get key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-...

# Cerebras Cloud (High-throughput Llama 3.1)
# Get key from: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=csk-...

# Hugging Face Inference API
# Get key from: https://huggingface.co/settings/tokens
HF_TOKEN=hf_...

# ------------------------------------------------------------------------------
# 2. LOCAL OFFLINE LLM (100% Free, Zero Key Required)
# ------------------------------------------------------------------------------
# Install Ollama from https://ollama.ai and start:
#   ollama run llama3.2
# Makima connects to http://127.0.0.1:11434 automatically.

# ------------------------------------------------------------------------------
# 3. WEB SEARCH & RESEARCH APIS (Optional)
# ------------------------------------------------------------------------------
# DuckDuckGo is built-in and free (zero key required).
# For external search engines:
# BRAVE_SEARCH_API_KEY=
# TAVILY_API_KEY=
# SERPER_API_KEY=

# ------------------------------------------------------------------------------
# 4. VOICE & SPEECH SYNTHESIS (Optional)
# ------------------------------------------------------------------------------
# Edge-TTS and Kokoro-ONNX run locally/free.
# ELEVENLABS_API_KEY=

# ------------------------------------------------------------------------------
# 5. MESSAGING & INTEGRATION CREDENTIALS (Optional)
# ------------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
# GITHUB_TOKEN=
# NOTION_API_KEY=
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
